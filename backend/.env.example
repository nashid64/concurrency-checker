# ---- copy this file to ".env" and edit ----
# mock   = no API key, no model (simple rule-based demo, to test the pipeline)
# llm    = Gemini (or any OpenAI-compatible API)
# model  = your fine-tuned local model (needs torch + transformers)
# hybrid = local model first; ask the LLM only when the model is unsure / finds a bug
DETECTOR_MODE=mock

# --- LLM settings (Gemini free tier through its OpenAI-compatible endpoint) ---
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Model names change over time. Run:  python scripts/list_models.py   and pick a current Flash / Flash-Lite model
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=60

# --- Local model settings ---
MODEL_DIR=./models/concurrency-model
HYBRID_SAFE_THRESHOLD=0.90

# --- Safety / limits ---
MAX_CODE_CHARS=60000
# If set, every request must send header  X-API-Key: <value>  (use this when the backend is public)
API_KEY=
# Allow the VS Code extension to choose the mode per request
ALLOW_MODE_OVERRIDE=true
